# Não são segredos (aparecem no navegador), mas ficam fora do código
# para trocar sem novo commit. Copie para .env.local.

# WhatsApp do CTA principal (somente dígitos, com DDI e DDD). Vazio = modo demonstração (portfólio)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Mensagem pré-preenchida neutra (harness R12)
NEXT_PUBLIC_WHATSAPP_MESSAGE="Olá! Vim pelo site e gostaria de agendar uma consulta."

# Link do Calendly (protótipo: conta de demonstração do João)
NEXT_PUBLIC_CALENDLY_URL=

# Google Analytics 4 (carrega só após consentimento)
NEXT_PUBLIC_GA4_ID=

# Perfil no Google (decisão 4 do harness): deixar VAZIO até o perfil ser corrigido (sem "Dermatologia Estética").
# Preenchido, mostra um link discreto "Ver no Google", sem nota nem avaliações.
NEXT_PUBLIC_GOOGLE_PERFIL_URL=


# Endereço do site (canonical, Open Graph, sitemap, JSON-LD). Vazio: na Vercel usa o domínio de produção do projeto
NEXT_PUBLIC_SITE_URL=
# Indexação nos buscadores: vazio na prévia (noindex e robots.txt fechado); 1 só na publicação definitiva, depois do aceite
NEXT_PUBLIC_INDEXAR=
